# VOIDTRACE — Environment Configuration Template
# Copy this file to .env and fill in real values.
# NEVER commit .env to version control.

# Application info (optional; defaults shown)
APP_NAME=VOIDTRACE
APP_VERSION=1.0.0
DEBUG=False

# Server binding (optional; defaults shown)
HOST=127.0.0.1
PORT=8000

# Switch Core REST API and WebSocket base URLs
SWITCH_SERVER_URL=http://127.0.0.1:53450
SWITCH_WS_URL=ws://127.0.0.1:53450

# Optional authenticated relay shared secret.
# The app sends this value as X-Voidtrace-Relay-Secret.
# If the relay is used, the relay process must have
# VOIDTRACE_RELAY_SECRET set to the exact same value.
# Leave both empty when connecting directly to local Switch Core.
SWITCH_RELAY_SECRET=
VOIDTRACE_RELAY_SECRET=

# Bootstrap registration token (from switch-core.env, AGENT_REGISTRATION_TOKEN).
# The app accepts either SWITCH_REGISTRATION_TOKEN or AGENT_REGISTRATION_TOKEN.
# Leave empty to disable auto-registration on startup.
SWITCH_REGISTRATION_TOKEN=

# Switch agent identity. AGENT_NAME must match the deployed agent name.
AGENT_NAME=voidtrace
AGENT_DISPLAY_NAME=VOIDTRACE
AGENT_DESCRIPTION=Defensive AI-powered security incident investigation and response platform

# SQLite database file path (relative to workspace root)
DATABASE_PATH=voidtrace.db

# Switch connection behavior
AUTO_CONNECT_SWITCH=True
SWITCH_RECONNECT_INITIAL_DELAY=2.0
SWITCH_RECONNECT_MAX_DELAY=30.0
SWITCH_HEARTBEAT_INTERVAL=2.0

# Required as a Bearer token for every mutating API request
# (POST, PUT, PATCH, DELETE). Generate a long random value.
# If unset, all mutating requests fail closed.
VOIDTRACE_API_TOKEN=

# Explicit local-development opt-in. When VOIDTRACE_API_TOKEN is unset,
# this allows unauthenticated mutations from loopback clients only.
# Never enable this on a public or proxied deployment.
VOIDTRACE_ALLOW_INSECURE_LOCAL_MUTATIONS=False

# Signature demo, isolated from voidtrace.db:
# .\.venv\Scripts\python.exe -m app.demo
